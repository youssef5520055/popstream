generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   Review[]
  watchList Movie[]  @relation("UserWatchList")
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String
  posterUrl   String?
  videoUrl    String?
  genre       String
  releaseYear Int
  rating      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     Review[]
  watchers    User[]   @relation("UserWatchList")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  userId    String
  movieId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
